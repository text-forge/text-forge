; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Text Forge"
config/version="0.2"
run/main_scene="uid://dx1alvj3tjt16"
config/use_custom_user_dir=true
config/custom_user_dir_name="Text Forge"
config/auto_accept_quit=false
config/quit_on_go_back=false
config/features=PackedStringArray("4.5", "Forward Plus")
run/max_fps=60
boot_splash/bg_color=Color(0.0823529, 0.121569, 0.160784, 1)
boot_splash/image="uid://c53xda8pdrml6"
config/icon="uid://c5as0fd5jhnm8"

[autoload]

Signals="*res://core/autoload/signals.gd"
Global="*res://core/autoload/global.gd"
Tests="*res://core/autoload/tests.gd"
Settings="*res://core/autoload/settings.gd"
Factory="*res://core/autoload/factory.gd"
ExtensionHub="*res://core/autoload/extension_hub.gd"
Extensions="*res://core/autoload/extensions.gd"
U="*res://core/autoload/utils.gd"
NetSuite="*res://core/autoload/net_suite.gd"
BackupCore="*res://core/autoload/backup_core.gd"
Project="*res://core/autoload/project.gd"

[debug]

file_logging/max_log_files=200
gdscript/warnings/unused_parameter=0
gdscript/warnings/narrowing_conversion=0

[display]

window/energy_saving/keep_screen_on=false
window/subwindows/embed_subwindows=false
window/stretch/aspect="ignore"
window/per_pixel_transparency/allowed=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[gdunit4]

settings/test/test_lookup_folder="tests"
settings/test/test_suite_naming_convention=1
ui/toolbar/run_overall=true
templates/testsuite/GDScript="# GdUnit generated TestSuite
class_name ${suite_class_name}
extends GdUnitTestSuite
@warning_ignore('unused_parameter')
@warning_ignore('return_value_discarded')

# TestSuite generated from
const __source = '${source_resource_path}'

var ${source_var}: ${source_class}

func before() -> void:
	${source_var} = ${source_class}.new()"
report/godot/push_error=true

[gui]

theme/custom="uid://biemqm07w26kl"

[internationalization]

locale/translations=PackedStringArray("res://core/translations/en.po", "res://core/translations/fa.po", "res://core/translations/pl.po")

[rendering]

environment/defaults/default_clear_color=Color(0.11834, 0.167543, 0.216756, 1)
